{
  "name": "tegrad",
  "version": "0.0.0",
  "private": true,
  "description": "Tegra Agent: headless Minecraft server manager",
  "license": "AGPL-3.0-only",
  "author": "Antônio Miranda <oi@antmiranda.dev>",
  "type": "module",
  "exports": {
    "./protocol": {
      "types": "./lib/types/protocol/index.d.ts",
      "import": "./lib/protocol/index.js",
      "default": "./lib/protocol/index.js"
    },
    "./crypto": {
      "types": "./lib/types/crypto/index.d.ts",
      "import": "./lib/crypto/index.js",
      "default": "./lib/crypto/index.js"
    },
    "./vault": {
      "types": "./lib/types/vault/index.d.ts",
      "import": "./lib/vault/index.js",
      "default": "./lib/vault/index.js"
    }
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile src/index.ts --outfile dist/tegrad",
    "lint": "biome check . && bun scripts/check-headers.ts",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:lib": "bun scripts/build-lib.ts",
    "check:lib": "bun scripts/build-lib.ts && bun scripts/smoke-lib.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "@types/libsodium-wrappers-sumo": "^0.8.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.3.0",
    "@zxcvbn-ts/language-common": "^4.2.0",
    "@zxcvbn-ts/language-en": "^4.1.2",
    "libsodium-wrappers-sumo": "^0.8.4",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "files": [
    "lib"
  ]
}

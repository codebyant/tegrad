// Restrict tegrad to managing only Minecraft server and permission-sync template units.
// Granting org.freedesktop.systemd1.manage-units on arbitrary units
// would allow manipulating privileged services and would be equivalent to root.
polkit.addRule(function(action, subject) {
  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    subject.user === "tegrad"
  ) {
    var unit = action.lookup("unit");
    if (
      typeof unit === "string" &&
      /^(tegrad-server@[a-z0-9][a-z0-9-]{0,62}\.(service|socket)|tegrad-perms@[a-z0-9][a-z0-9-]{0,62}\.service)$/.test(unit)
    ) {
      return polkit.Result.YES;
    }
  }
  return polkit.Result.NOT_HANDLED;
});
